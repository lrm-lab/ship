# Copy to .env.

# The CoForge issuer: <your CoForge origin>/oidc, no trailing slash.
COFORGE_ISSUER=https://coforge.example.com/oidc
# The app's client ID; Agent access tokens carry it as their audience.
COFORGE_CLIENT_ID=ship
# The public https origin this service is served at (the manifest's base_url is APP_ORIGIN + /api).
APP_ORIGIN=http://localhost:3000
PORT=3000
