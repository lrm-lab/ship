# Copy to .env.

# The CoForge deployments Ship trusts, as a JSON array. Each deployment registers Ship as its own
# app, so each has its own client ID (the audience of the Agent tokens it issues). An issuer is
# <CoForge origin>/oidc: https, or http on localhost only, no trailing slash. One line.
SHIP_TRUSTED_ISSUERS=[{"issuer":"https://coforge.cn/oidc","clientId":"replace-with-the-client-id"}]
# The public https origin this service is served at (the manifest's base_url is APP_ORIGIN + /api).
APP_ORIGIN=http://localhost:3000
PORT=3000
# PostgreSQL connection string.
DATABASE_URL=postgresql://ship:ship@localhost:5432/ship
