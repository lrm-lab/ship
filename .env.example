# Copy to .env.

# The CoForge deployments Ship trusts, as a JSON array on one line. Each deployment registers Ship
# as its own app, so each has its own client ID (the audience of the Agent tokens it issues). An
# issuer is <CoForge origin>/oidc: https, or http on localhost only, no trailing slash.
SHIP_TRUSTED_ISSUERS=[{"issuer":"https://coforge.cn/oidc","clientId":"replace-with-the-client-id"},{"issuer":"https://staging.coforge.cn/oidc","clientId":"replace-with-the-staging-client-id"}]
# The public https origin this service is served at (the manifest's base_url is APP_ORIGIN + /api).
APP_ORIGIN=http://localhost:3000
PORT=3000
# The interface to listen on (default 0.0.0.0).
# HOST=127.0.0.1
# PostgreSQL connection string. Apply the migrations with `bun run db:migrate:deploy`.
DATABASE_URL=postgresql://ship:ship@localhost:5432/ship
